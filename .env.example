# MagnetFlow configuration — copy to .env and fill in real values.
# NEVER commit your real .env file.

# HTTP port
PORT=3000

# Bind address. Default 0.0.0.0 (reachable on all interfaces).
# Set to 127.0.0.1 when running behind a reverse proxy (Caddy/Nginx) so the
# app is NOT directly reachable on the public IP — only via the proxy/HTTPS.
HOST=0.0.0.0

# REQUIRED. A long random string used to sign JWTs.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start if this is empty or left at the default.
JWT_SECRET=

# Where downloaded files are stored.
DOWNLOAD_DIR=/root/downloads

# aria2 JSON-RPC endpoint and secret token.
ARIA2_RPC_URL=http://localhost:6800/jsonrpc
ARIA2_SECRET=

# Optional: password for the auto-created "admin" user on first run.
# If omitted, a strong random password is generated and printed once.
# INITIAL_ADMIN_PASSWORD=

# Auto-clear completed download records (the downloaded FILES are always kept;
# only aria2's record is removed). Set to false to disable.
AUTO_CLEAR_COMPLETED=true
# How long (seconds) a finished item stays visible before its record is cleared.
AUTO_CLEAR_DELAY_SEC=15

# rclone remote-control daemon (for cloud uploads)
RCLONE_RC_URL=http://127.0.0.1:5572

# Transmission RPC (optional second download engine; magnet/torrent only).
# Leave as-is for the bundled local daemon. If unreachable, the engine selector
# is hidden and everything falls back to aria2.
TRANSMISSION_RPC_URL=http://127.0.0.1:9091/transmission/rpc

# Auto-upload finished downloads to a cloud remote (rclone). Leave REMOTE empty
# to disable. REMOTE must be a configured rclone remote (e.g. onedrive); DEST is
# an optional folder on that remote.
AUTO_UPLOAD_REMOTE=
AUTO_UPLOAD_DEST=

# Download-complete notifications (all optional; leave empty to disable).
NOTIFY_TELEGRAM_BOT_TOKEN=
NOTIFY_TELEGRAM_CHAT_ID=
NOTIFY_BARK_URL=
